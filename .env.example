# Copy to .env and fill in. Never commit .env.

# Database — matches docker-compose.yml (port 5433 to avoid clashing with a local postgres)
DATABASE_URL=postgresql+psycopg2://freshroute:freshroute@localhost:5433/freshroute
POSTGRES_USER=freshroute
POSTGRES_PASSWORD=freshroute
POSTGRES_DB=freshroute

# data.gov.in live daily feed — get your own key at data.gov.in/user/register
# the shared public key is rate-limited and unreliable
DATA_GOV_IN_API_KEY=

# Agmarknet SDK — no key needed, just tune the delay if you get blocked
AGMARKNET_REQUEST_DELAY_SEC=1.0

# OSRM self-hosted routing (Phase 2) — run scripts/osrm_bootstrap.sh first
OSRM_BASE_URL=http://localhost:5000

# Runtime
LOG_LEVEL=INFO
ENV=dev
