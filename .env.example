# Copy to .env and fill in. Never commit .env.

# ─── Database ──────────────────────────────────────────────────────────
# Matches docker-compose.yml. Port 5433 to avoid clashing with a local Postgres.
DATABASE_URL=postgresql+psycopg2://freshroute:freshroute@localhost:5433/freshroute
POSTGRES_USER=freshroute
POSTGRES_PASSWORD=freshroute
POSTGRES_DB=freshroute

# ─── data.gov.in (Phase 1 live daily feed — prices only) ──────────────
# Register at https://data.gov.in/user/register for your own key.
# The shared public key is rate-limited and unreliable.
DATA_GOV_IN_API_KEY=

# ─── Agmarknet SDK ─────────────────myjyjjyyyyttytytytytytytyt────────────────────────────────────
# The `agmarknet` PyPI package scrapes the official site; no key required.
# Set an overriding rate limit in seconds between requests if you get blocked.
AGMARKNET_REQUEST_DELAY_SEC=1.0

# ─── Open-Meteo (Phase 4 — no key needed for non-commercial) ──────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ─── OSRM (Phase 2 — self-hosted) ──────────────────────────────────────
OSRM_BASE_URL=http://localhost:5000

# ─── Alerts (Phase 6 — leave blank until then) ────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ─── Runtime ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENV=dev
